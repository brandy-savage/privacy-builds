diff --git a/src/common/privateAddons.js b/src/common/privateAddons.js
new file mode 100644
index 0000000..c5bbef5
--- /dev/null
+++ b/src/common/privateAddons.js
@@ -0,0 +1,19 @@
+// Copyright (C) 2017-2023 Smart code 203358507
+
+const BLOCKED_PURCHASE_ADDON_IDS = new Set([
+    'org.stremio.watchhub',
+]);
+
+const isPrivateBlockedAddon = (addon) => {
+    const id = String(addon?.manifest?.id || '').toLowerCase();
+    const name = String(addon?.manifest?.name || '').toLowerCase();
+    const transportUrl = String(addon?.transportUrl || '').toLowerCase();
+
+    return BLOCKED_PURCHASE_ADDON_IDS.has(id) ||
+        name === 'watchhub' ||
+        transportUrl.includes('watchhub.strem.io');
+};
+
+module.exports = {
+    isPrivateBlockedAddon,
+};
diff --git a/tests/privateAddons.spec.js b/tests/privateAddons.spec.js
new file mode 100644
index 0000000..e02ce14
--- /dev/null
+++ b/tests/privateAddons.spec.js
@@ -0,0 +1,20 @@
+// Copyright (C) 2017-2023 Smart code 203358507
+
+const { isPrivateBlockedAddon } = require('../src/common/privateAddons');
+
+describe('private addon policy', () => {
+    test.each([
+        [{ manifest: { id: 'org.stremio.watchhub', name: 'WatchHub' }, transportUrl: 'https://watchhub.strem.io/manifest.json' }],
+        [{ manifest: { id: 'future.watch-provider', name: 'WatchHub' }, transportUrl: 'https://example.test/manifest.json' }],
+        [{ manifest: { id: 'future.watch-provider', name: 'Provider' }, transportUrl: 'https://watchhub.strem.io/manifest.json' }],
+    ])('blocks WatchHub purchase sources', (addon) => {
+        expect(isPrivateBlockedAddon(addon)).toBe(true);
+    });
+
+    test('keeps playable local and privacy addons', () => {
+        expect(isPrivateBlockedAddon({
+            manifest: { id: 'local.privacy.premiumize', name: 'Private Premiumize' },
+            transportUrl: 'http://127.0.0.1:17100/addons/premiumize/manifest.json',
+        })).toBe(false);
+    });
+});
