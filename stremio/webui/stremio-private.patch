+        console.error('Failed to prepare the local-only profile:', error);
+    }
 }
 
+const preparePrivateAddons = async () => {
+    if (!privateLocalMode) return;
+    if ('serviceWorker' in navigator) {
+        try {
+            const registrations = await navigator.serviceWorker.getRegistrations();
+            await Promise.all(registrations.map((registration) => registration.unregister()));
+        } catch (error) {
+            console.warn('Could not remove the legacy service worker:', error);
+        }
+    }
+    if ('caches' in window) {
+        try {
+            const cacheNames = await window.caches.keys();
+            await Promise.all(cacheNames.map((cacheName) => window.caches.delete(cacheName)));
+        } catch (error) {
+            console.warn('Could not clear the legacy web cache:', error);
+        }
+    }
+    let addonIndex = null;
+    for (let attempt = 0; attempt < 10 && addonIndex === null; attempt += 1) {
+        try {
+            const response = await fetch('http://127.0.0.1:17100/addons/index.json', { cache: 'no-store' });
+            if (!response.ok) throw new Error(`HTTP ${response.status}`);
+            addonIndex = await response.json();
+        } catch (error) {
+            if (attempt === 9) {
+                console.warn('Private addon index was not ready before core startup:', error);
+                break;
+            }
+            await new Promise((resolve) => window.setTimeout(resolve, 250));
+        }
+    }
+    if (!Array.isArray(addonIndex?.addons)) return;
+    try {
+        const rawProfile = window.localStorage.getItem('profile');
+        if (!rawProfile) return;
+        const localProfile = JSON.parse(rawProfile);
+        const existing = Array.isArray(localProfile.addons) ? localProfile.addons : [];
+        const customIds = new Set(addonIndex.addons.map((addon) => addon?.manifest?.id).filter(Boolean));
+        const customUrls = new Set(addonIndex.addons.map((addon) => addon?.transportUrl).filter(Boolean));
+        const retained = existing.filter((addon) => (
+            !isPrivateBlockedAddon(addon) &&
+            !customIds.has(addon?.manifest?.id) &&
+            !customUrls.has(addon?.transportUrl) &&
+            !addon?.manifest?.id?.startsWith('local.privacy.')
+        ));
+        localProfile.auth = null;
+        localProfile.addonsLocked = false;
+        localProfile.addons = [...retained, ...addonIndex.addons];
+        window.localStorage.setItem('profile', JSON.stringify(localProfile));
+    } catch (error) {
+        console.error('Failed to install the private addon set before core startup:', error);
+    }
+};
